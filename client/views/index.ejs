<html>

<head>
    <title>My ama bot</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>My AMA Bot</h1>
    <p id="response"></p>
    <ul id="questionList"></ul>
    
    <form id="questionForm" method="POST" action="/ask">
        <input type="text" id="userInput" name="question" placeholder="Ask me anything...">
        <button type="submit">Ask</button>
    </form>

    <form method="POST" action="/clearMessages">
        <button type="submit">Clear Messages</button>
    </form>

    <h2>Spørgsmål og stats</h2>
    <ul>
        <li>Navn: <%= topicStats.navn %></li>
        <li>Bosted: <%= topicStats.bosted %></li>
        <li>Fritid: <%= topicStats.Fritid %></li>
    </ul>

    <% for (const message of messageList) { %>
        <article class="<%= message.type %>">
            <p><%= message.text %></p>
        </article>
    <% } %>
    <% if (error) { %>
        <p role="alert"><%= error %></p>
    <% } %>

</body>

</html>